# SQLite for zero-config local development. Swap to PostgreSQL connection string for production.
DATABASE_URL="file:./dev.db"

# Required for signing HTTP-only session cookies (use a long random string in production)
AUTH_SECRET="dev-verifylaunch-secret-change-in-production-32chars"

# Base URL used for OAuth callbacks and email verification links
APP_URL="http://localhost:3000"

# Set to "true" locally to enable 1-click Buyer / Maker / Editor persona switching
DEV_AUTH_MODE="true"

# Optional: Configure GitHub OAuth to enable real GitHub identity verification
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
