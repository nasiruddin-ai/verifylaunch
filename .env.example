# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/verifylaunch?schema=public"

# Required for signing HTTP-only session cookies (use a long random 32+ char string in production)
AUTH_SECRET="replace-with-a-random-32-char-production-secret"

# Base URL used for OAuth callbacks and email verification links (e.g., https://verifylaunch.vercel.app)
APP_URL="http://localhost:3000"

# Set to "true" to enable 1-click Buyer / Maker / Editor demo persona switching (set "false" in production)
DEV_AUTH_MODE="true"

# Optional: Configure Resend (https://resend.com) to send live email verification links
RESEND_API_KEY=""
EMAIL_FROM="VerifyLaunch <onboarding@resend.dev>"

# Optional: Configure GitHub OAuth to enable real GitHub identity verification
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
